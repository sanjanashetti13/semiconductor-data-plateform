# =============================================================================
# Semiconductor Intelligence Hub — environment template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO
PROJECT_NAME=semiconductor-intelligence-hub
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Curated manufacturing warehouse (Mode 1)
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=semiconductor_dw
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server

AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=semiconductor_dw
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend
VITE_API_BASE_URL=
VITE_POWERBI_URL=
VITE_GITHUB_URL=
