# =============================================================================
# Semiconductor Intelligence Hub — environment template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO
PROJECT_NAME=semiconductor-intelligence-hub

# Comma-separated browser origins for local Vite (not needed for same-origin App Service).
# Leave empty in production when UI and API share https://<app>.azurewebsites.net
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set true only for temporary operator checks of ODBC Driver 18 (not for public prod).
ENABLE_DIAGNOSTICS=false

# Set true to keep /docs and /redoc when APP_ENV=production
ENABLE_API_DOCS=false

# -----------------------------------------------------------------------------
# LLM (required)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Mode 1 — curated semiconductor warehouse (optional for Generic SQL Mode)
# Generic Mode users supply Azure SQL credentials in the UI (server memory only).
# -----------------------------------------------------------------------------
SQL_SERVER=
SQL_DATABASE=
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Aliases (optional; same meaning as SQL_*)
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# -----------------------------------------------------------------------------
# Power BI — optional default URL hint for docs/ops only.
# End users configure the report URL in the app (browser localStorage).
# Never put Power BI tokens or secrets here.
# -----------------------------------------------------------------------------
POWERBI_URL=

# -----------------------------------------------------------------------------
# Frontend build-time (optional). For Azure App Service one-server deploy leave
# empty / unset so the browser calls relative /api/... on the same origin.
# Never set VITE_SQL_* or VITE_GROQ_* — secrets must stay in App Service settings.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_POWERBI_URL=
