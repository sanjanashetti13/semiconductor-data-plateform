# =============================================================================
# Environment variables — copy to .env and fill in real values.
# Never commit .env to version control.
# =============================================================================

# Application
APP_ENV=development
LOG_LEVEL=INFO
PROJECT_NAME=semiconductor-data-platform

# Paths (relative to project root unless absolute)
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_WAREHOUSE_PATH=data/warehouse

# Spark / Databricks
SPARK_MASTER=local[*]
SPARK_APP_NAME=semiconductor-etl
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=

# Azure SQL Database
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=semiconductor_dw
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_PORT=1433

# LLM providers (use one or both)
LLM_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# LangChain / tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Power BI (optional automation)
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
