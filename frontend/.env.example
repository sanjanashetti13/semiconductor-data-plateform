# Leave empty for same-origin production (Azure App Service serves UI + /api).
# Local Vite proxy already forwards /api → http://127.0.0.1:8000.
VITE_API_BASE_URL=

# Optional default Power BI report URL (public URL only — no tokens).
# Users can still set/override this in the app UI (localStorage).
VITE_POWERBI_URL=
